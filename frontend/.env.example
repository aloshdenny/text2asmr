# Supabase project (Project Settings -> API). The anon / publishable key is safe in the browser:
# row-level security and the RPCs in backend/supabase/migrations decide what it can do.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# 1 shows "Continue with GitHub" (enable the GitHub provider in Supabase Auth first)
VITE_GITHUB_AUTH=0
